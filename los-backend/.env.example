# ── Database Configuration ─────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/los?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ── Gmail SMTP Configuration (For OTP) ──────────────────────────
# Your Gmail address used to send OTP emails
MAIL_USERNAME=your-email@gmail.com

# 16-character Google App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your_16_character_app_password

# ── JWT (JSON Web Token) Configuration ──────────────────────────
# Secret key (at least 32 characters long for HMAC-SHA256)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000
