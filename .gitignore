# =============================================================================
# Root .gitignore for Loan Origination System (LOS)
# =============================================================================

# 1. Sensitive Environment Variables (DO NOT COMMIT)
**/.env
**/.env.*
!**/.env.example

# 2. Java / Maven build artifacts
**/target/
**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
HELP.md

# 3. Node / React build artifacts & dependencies
**/node_modules/
**/dist/
**/build/
**/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. IDEs and Editors
.vscode/
.idea/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# 5. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 6. Runtime data & logs
logs/
*.log
pids
*.pid
*.seed
*.pid.lock
